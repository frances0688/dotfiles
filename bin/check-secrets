#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PATTERNS=(
  'BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY'
  'gho_[A-Za-z0-9_]+'
  'ghp_[A-Za-z0-9_]+'
  'github_pat_[A-Za-z0-9_]+'
  'xox[baprs]-[A-Za-z0-9-]+'
  'sk-[A-Za-z0-9]{20,}'
  'AKIA[0-9A-Z]{16}'
  'ssh-ed25519 AAAA[0-9A-Za-z+/]+'
  'password\s*='
  'api[_-]?key\s*='
)

found=0
while IFS= read -r -d '' file; do
  for pattern in "${PATTERNS[@]}"; do
    if grep -qE "$pattern" "$file" 2>/dev/null; then
      # Allow ssh-ed25519 only in github-ssh-setup output paths? Actually we block all ssh-ed25519 public keys in repo
      if [[ "$pattern" == 'ssh-ed25519 AAAA*' ]]; then
        echo "WARN: possible SSH public key in $file"
        found=1
      else
        echo "FAIL: pattern '$pattern' matched in $file"
        found=1
      fi
    fi
  done
done < <(git ls-files -z)

if [[ $found -ne 0 ]]; then
  echo "Secret scan failed."
  exit 1
fi

echo "Secret scan passed."
